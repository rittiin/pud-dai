# Optional — without a key, EpiChat uses offline Thai keyword extraction and a template report.

# Option A: Typhoon (Thai LLM, free tier) — get a key at https://playground.opentyphoon.ai/api-key
TYPHOON_API_KEY=
# TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct

# Option B: OpenAI (used only when TYPHOON_API_KEY is empty)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
