# Select one OpenAI-compatible provider per request. Never fan out health text.
# AI_PROVIDER=typhoon (default if TYPHOON_API_KEY is set)
# AI_PROVIDER=openai
# AI_PROVIDER=custom

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OpenAI text-to-speech (prototype model; migrate before its Jan 6, 2027 shutdown)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Typhoon
TYPHOON_API_KEY=
# TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct

# Optional OpenAI-compatible provider
# AI_BASE_URL=https://provider.example/v1
# AI_API_KEY=
# AI_MODEL=provider-model-name

# Without a key, Pud-dai uses offline Thai keyword extraction and a template report.
